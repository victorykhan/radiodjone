datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  passwordHash String
  role         String        @default("VIEWER")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  activityLogs ActivityLog[]
}

model Track {
  id               Int                 @id @default(autoincrement())
  title            String
  artist           String?
  album            String?
  duration         Float
  fileHash         String              @unique
  filePath         String
  fileType         String              @default("SONG")
  coverArtUrl      String?
  isDeleted        Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  categories       TrackCategory[]
  playlists        PlaylistTrack[]
  fallbackItem     FallbackPoolItem?
  playLogs         PlayLog[]
  adTrack          AdTrack?
  cartTracks       CartTrack[]
  fallbackTracks   FallbackPoolTrack[]
  volumeTrim       Float               @default(1.0)
  cueStart         Float               @default(0.0)
  cueIntro         Float               @default(0.0)
  cueOutro         Float               @default(0.0)
  cueEnd           Float               @default(0.0)
  fadeDuration     Float?
  isExplicit       Boolean             @default(false)
}

model TrackCategory {
  id          Int             @id @default(autoincrement())
  name        String          @unique
  description String?
  parentId    Int?
  parent      TrackCategory?  @relation("SubCategories", fields: [parentId], references: [id], onDelete: SetNull)
  children    TrackCategory[] @relation("SubCategories")
  tracks      Track[]
}

model Playlist {
  id           Int             @id @default(autoincrement())
  name         String
  isScheduled  Boolean         @default(false)
  scheduleTime String?
  duration     Float           @default(0.0)
  isLooping    Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  tracks       PlaylistTrack[]
}

model PlaylistTrack {
  id         Int      @id @default(autoincrement())
  playlistId Int
  trackId    Int
  position   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  @@unique([playlistId, position])
}

// Legacy single fallback pool (kept for migration safety)
model FallbackPoolItem {
  id        Int      @id @default(autoincrement())
  trackId   Int      @unique
  priority  Int      @default(0)
  createdAt DateTime @default(now())
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
}

// Named Carts (Sweepers, Station IDs, Drops, Jingles)
model Cart {
  id          Int         @id @default(autoincrement())
  name        String
  type        String      @default("JINGLE") // SWEEPER, STATION_ID, DROP, JINGLE, OTHER
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  tracks      CartTrack[]
}

model CartTrack {
  id       Int   @id @default(autoincrement())
  cartId   Int
  trackId  Int
  position Int   @default(0)
  cart     Cart  @relation(fields: [cartId], references: [id], onDelete: Cascade)
  track    Track @relation(fields: [trackId], references: [id], onDelete: Cascade)
  @@unique([cartId, trackId])
}

// Multiple named fallback pools, priority-ordered (lower number = plays first)
model FallbackPool {
  id          Int                 @id @default(autoincrement())
  name        String
  description String?
  priority    Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  tracks      FallbackPoolTrack[]
}

model FallbackPoolTrack {
  id       Int          @id @default(autoincrement())
  poolId   Int
  trackId  Int
  position Int          @default(0)
  pool     FallbackPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  track    Track        @relation(fields: [trackId], references: [id], onDelete: Restrict)
  @@unique([poolId, trackId])
}

// Time-based schedule blocks (up to 3 months ahead)
model ScheduleBlock {
  id             Int      @id @default(autoincrement())
  name           String
  contentType    String   // PLAYLIST, CART
  contentId      Int?
  startTime      DateTime
  endTime        DateTime
  isRecurring    Boolean  @default(false)
  recurrenceDays String?  // "MON,TUE,WED,THU,FRI" etc.
  color          String   @default("#00f0ff")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([startTime])
  @@index([endTime])
}

model PlayLog {
  id             Int      @id @default(autoincrement())
  trackId        Int
  playedAt       DateTime @default(now())
  durationPlayed Float
  status         String   @default("COMPLETED")
  listenerCount  Int      @default(0)
  wasAd          Boolean  @default(false)
  track          Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  details   String?
  timestamp DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model SystemSetting {
  key   String @id
  value String
}

model ListenerSession {
  id             String    @id @default(uuid())
  icecastId      String
  ipHash         String
  country        String    @default("Unknown")
  city           String    @default("Unknown")
  userAgent      String?
  deviceType     String    @default("Desktop")
  connectedAt    DateTime  @default(now())
  disconnectedAt DateTime?
  duration       Int?
  @@index([connectedAt])
  @@index([disconnectedAt])
}

model Campaign {
  id                String    @id @default(uuid())
  clientName        String
  clientIndustry    String
  name              String
  startDate         DateTime
  endDate           DateTime
  targetPlays       Int
  currentPlays      Int       @default(0)
  targetImpressions Int
  cpc               Float
  dailyCap          Int
  hourlyCap         Int
  validHoursStart   Int       @default(0)
  validHoursEnd     Int       @default(23)
  ads               AdTrack[]
}

model AdTrack {
  id         String  @id @default(uuid())
  trackId    Int     @unique
  campaignId String
  track      Track   @relation(fields: [trackId], references: [id], onDelete: Cascade)
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

// Legacy 5-slot instant carts (kept for migration safety)
model InstantCart {
  slot    Int   @id
  trackId Int
}
